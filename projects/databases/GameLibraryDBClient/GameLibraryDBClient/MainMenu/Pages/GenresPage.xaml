<Page x:Class="GameLibraryDBClient.MainMenu.Pages.GenresPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameLibraryDBClient.MainMenu.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="600"
      Title="Genres">

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button Height="30" Width="200" Name="AddGenreBTN" Click="AddGenreBTN_Click">Add Genre</Button>
            <Button Height="30" Width="200" Name="BestEarningGenreBTN" Click="BestEarningGenreBTN_Click" >Show Best Earing Genre</Button>
            <Button Height="30" Width="200" Name="BestRatedGenreBTN" Click="BestRatedGenreBTN_Click">Show Best Rated Genre</Button>
        </StackPanel>
        <ScrollViewer Height="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ListView Name="GenresListView" MouseDoubleClick="ListView_MouseDoubleClick" >
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nazwa" DisplayMemberBinding="{Binding Name}" Width="200" />
                        <GridViewColumn Header="Srednia ocen" DisplayMemberBinding="{Binding AverageRating}" Width="200" />
                        <GridViewColumn Header="Suma Zarobków" DisplayMemberBinding="{Binding Earnings}" Width="200" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>
        <Popup Name="AddPopup" Placement="Mouse" StaysOpen="False" VerticalOffset="10" HorizontalOffset="10">
            <Border Background="LightYellow" BorderBrush="Black" BorderThickness="1" Padding="10">
                <StackPanel>
                    <Label  Content="Name: " Margin="0,0,0,10"/>
                    <TextBox x:Name="GenreName"/>
                    <TextBlock/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add" Width="75" HorizontalAlignment="Right" Click="AddPopupButton_Click"/>
                        <Button Content="Cancle" Width="75" HorizontalAlignment="Right" Click="ClosePopupButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</Page>
