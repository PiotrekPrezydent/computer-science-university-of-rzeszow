<Page x:Class="GameLibraryDBClient.MainMenu.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameLibraryDBClient.MainMenu"
      mc:Ignorable="d" 
      d:DesignHeight="380" d:DesignWidth="600"
      Title="GamesPage">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button Height="30" Width="200" Name="BestRatedGameBTN" Click="BestRatedGameBTN_Click">Show Best Rated Game</Button>
            <Button Height="30" Width="200" Name="BestEarningGameBTN" Click="BestEarningGameBTN_Click">Show Best Earing Game</Button>
            <Button Height="30" Width="200" Name="AddGameBTN" Click="AddGameBTN_Click">AddGame</Button>
        </StackPanel>
        <ScrollViewer Height="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ListView Name="GamesListView" MouseDoubleClick="ListView_MouseDoubleClick" >
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nazwa" DisplayMemberBinding="{Binding Title}" Width="100" />
                        <GridViewColumn Header="Data wydania" DisplayMemberBinding="{Binding ReleaseDate}" Width="100" />
                        <GridViewColumn Header="Cena" DisplayMemberBinding="{Binding Price}" Width="50" />
                        <GridViewColumn Header="Tworca" DisplayMemberBinding="{Binding AuthorName}" Width="75" />
                        <GridViewColumn Header="Wydawca" DisplayMemberBinding="{Binding PublisherName}" Width="75" />
                        <GridViewColumn Header="Sprzedaz" DisplayMemberBinding="{Binding SoldCopies}" Width="70" />
                        <GridViewColumn Header="Zarobek" DisplayMemberBinding="{Binding TotalEarnings}" Width="70" />
                        <GridViewColumn Header="Ocena" DisplayMemberBinding="{Binding AverageRatings}" Width="50" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>
        <Popup Name="InfoPopup" Placement="Mouse" StaysOpen="False" VerticalOffset="10" HorizontalOffset="10">
            <Border Background="LightYellow" BorderBrush="Black" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock x:Name="IdText" Text="ID: " Margin="0,0,0,10"/>
                    <TextBlock x:Name="NameText" Text="Name: " Margin="0,0,0,10"/>
                    <TextBlock x:Name="ScoreText" Text="-" Margin="0,0,0,10"/>
                    <Button Content="Close" Width="75" HorizontalAlignment="Right" Click="ClosePopupButton_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
    
</Page>
