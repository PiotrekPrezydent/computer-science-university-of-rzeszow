<Page x:Class="GameLibraryDBClient.MainMenu.Pages.PublishersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameLibraryDBClient.MainMenu.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="600"
      Title="PublishersPage">

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button Height="30" Width="200" Name="BestRatedPublisherBTN" Click="BestRatedPublisherBTN_Click" >Show Best Rated Publisher</Button>
            <Button Height="30" Width="200" Name="BestEarningPublisherBTN" Click="BestEarningPublisherBTN_Click">Show Best Earing Publisher</Button>
            <Button Height="30" Width="200" Name="AddPublisherBTN" Click="AddPublisherBTN_Click">Add Publisher</Button>
        </StackPanel>
        <ScrollViewer Height="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ListView Name="PublisherListView" MouseDoubleClick="ListView_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nazwa" DisplayMemberBinding="{Binding Name}" Width="200" />
                        <GridViewColumn Header="MarzaProcent" DisplayMemberBinding="{Binding MarginPrecent}" Width="100" />
                        <GridViewColumn Header="Średnie Oceny" DisplayMemberBinding="{Binding AverageRating}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>
        <Popup Name="AddPopup" Placement="Mouse" StaysOpen="False" VerticalOffset="10" HorizontalOffset="10">
            <Border Background="LightYellow" BorderBrush="Black" BorderThickness="1" Padding="10">
                <StackPanel>
                    <Label  Content="Name: " Margin="0,0,0,10"/>
                    <TextBox x:Name="PublisherName"/>
                    <TextBlock/>
                    <Label  Content="MarginPrecent: " Margin="0,0,0,10"/>
                    <TextBox x:Name="Margin"/>
                    <TextBlock/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add" Width="75" HorizontalAlignment="Right" Click="AddPopupButton_Click"/>
                        <Button Content="Cancle" Width="75" HorizontalAlignment="Right" Click="ClosePopupButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</Page>
